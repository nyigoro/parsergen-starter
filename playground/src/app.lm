    tab_button("rail-tab-files", "Files", "rail", "files", "rail-files-panel"),
    tab_button("rail-tab-presets", "Presets", "rail", "presets", "rail-presets-panel")
  ]);
  let leftRail = vnode("aside", attrs2(props_class("left-rail dock-group dock-shell"), props_id("left-dock-group")), [
    leftRailHeader,
    leftRailTabs,
    workspacePanel,
    fileSidebar,
    presetPanel
  ]);
  let leftEdgeStrip = vnode("aside", attrs4(props_class("edge-strip left-edge-strip"), props_id("left-edge-strip"), props_attr("role", "tablist"), props_attr("aria-label", "Explorer edge panes")), [
    edge_tab_button("edge-rail-tab-workspace", "Workspace", "rail", "workspace", "left", "rail-workspace-panel"),
    edge_tab_button("edge-rail-tab-files", "Files", "rail", "files", "left", "rail-files-panel"),
    edge_tab_button("edge-rail-tab-presets", "Presets", "rail", "presets", "left", "rail-presets-panel")
  ]);

  let activeFile = vnode("span", attrs2(props_class("small-pill"), props_id("active-file-label")), [text("main.lm")]);
  let entryFile = vnode("span", attrs2(props_class("small-pill"), props_id("entry-file-label")), [text("entry: main.lm")]);
  let editorMeta = div_node("editor-meta-row", [entryFile, activeFile]);
  let fileTabs = vnode("div", attrs2(props_class("file-tabs"), props_id("file-tabs-root")), []);
  let editorMount = vnode("div", props_id("editor-root"), []);
  let editorPanel = vnode("section", props_class("editor-panel main-editor-panel stack-sm"), [
    editorTop,
    editorMeta,
    fileTabs,
    editorMount
  ]);
  let centerColumn = div_node("center-editor", [editorPanel]);

  let routeHeader = div_node("panel-heading-row", [
    vnode("div", props_class("panel-title"), [text("Route Preview")]),
    vnode("span", attrs2(props_class("small-pill"), props_id("route-preview-url")), [text("/")])
  ]);
  let routeFields = div_node("route-field-grid", [
    div_node("route-field", [field_label("Path"), text_input("route-path-input", "/dashboard")]),
    div_node("route-field", [field_label("Search"), text_input("route-search-input", "?tab=team")]),
    div_node("route-field", [field_label("Hash"), text_input("route-hash-input", "#activity")])
  ]);
  let routeButtons = div_node("tool-row compact-tools", [
    tool_button("route-apply-button", "Apply", "secondary"),
    tool_button("route-push-button", "Push", "secondary"),
    tool_button("route-replace-button", "Replace", "secondary"),
    tool_button("route-back-button", "Back", "secondary"),
    tool_button("route-forward-button", "Forward", "secondary"),
    tool_button("route-reset-button", "Reset", "secondary")
