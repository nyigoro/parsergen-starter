import { vnode, props_class, props_attr, props_merge } from "@std/render";
import { topbar } from "./topbar.lm";
import { editor_zone } from "./editor-zone.lm";
import { output_tabs } from "./output-tabs.lm";
import { diagnostics_panel } from "./diagnostics-panel.lm";
import { statusbar } from "./statusbar.lm";

fn attrs2(left: any, right: any) -> any {
  props_merge(left, right)
}

pub fn app() -> VNode {
  let mainSplit = vnode(
    "main",
    attrs2(
      props_class("single-source-main"),
      props_attr("style", "min-height:0;display:grid;grid-template-rows:minmax(0,1fr);grid-template-columns:minmax(0,1.15fr) minmax(22rem,0.85fr);gap:0.625rem;overflow:hidden;")
    ),
    [
      editor_zone(),
      vnode("section", attrs2(props_class("result-column"), props_attr("style", "min-height:0;display:grid;grid-template-rows:minmax(13rem,1fr) minmax(12rem,0.9fr);gap:0.625rem;overflow:hidden;")), [
        output_tabs(),
        diagnostics_panel()
      ])
    ]
  );

  vnode("div", props_class("playground-shell"), [
    vnode(
      "div",
      attrs2(
        props_class("playground-body"),
        props_attr("style", "grid-template-rows:auto minmax(0,1fr) auto;")
      ),
      [
        topbar(),
        mainSplit,
        statusbar()
      ]
    )
  ])
}
