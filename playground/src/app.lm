  let dockTabs = tab_list("dock-tabs", "Dock panes", [
    tab_button("dock-tab-preview", "Preview", "dock", "preview", "dock-panel-preview"),
    tab_button("dock-tab-problems", "Problems", "dock", "problems", "dock-panel-problems"),
    tab_button("dock-tab-route", "Route", "dock", "route", "dock-panel-route"),
    tab_button("dock-tab-packages", "Packages", "dock", "packages", "dock-panel-packages"),
    tab_button("dock-tab-graph", "Graph", "dock", "graph", "dock-panel-graph"),
    tab_button("dock-tab-compile", "Compile", "dock", "compile", "dock-panel-compile"),
    tab_button("dock-tab-inspector", "Inspector", "dock", "inspector", "dock-panel-inspector")
  ]);
  let previewDock = tab_panel("dock-panel-preview", "dock-tab-preview", "dock-panel", [routePanel]);
  let problemsDock = tab_panel("dock-panel-problems", "dock-tab-problems", "dock-panel", [diagnosticsPanel]);
  let routeDock = tab_panel("dock-panel-route", "dock-tab-route", "dock-panel", [routeInspectorPanel]);
  let packageDock = tab_panel("dock-panel-packages", "dock-tab-packages", "dock-panel", [packagePanel]);
  let graphDock = tab_panel("dock-panel-graph", "dock-tab-graph", "dock-panel", [debugPanel]);
  let compileDock = tab_panel("dock-panel-compile", "dock-tab-compile", "dock-panel", [compilePanel]);
  let inspectorDock = tab_panel("dock-panel-inspector", "dock-tab-inspector", "dock-panel", [insightPanel]);
  let rightDock = vnode("aside", attrs2(props_class("right-dock dock-group dock-shell"), props_id("right-dock-shell")), [
    rightDockHeader,
    dockTabs,
    previewDock,
    problemsDock,
    routeDock,
    packageDock,
    graphDock,
    compileDock,
    inspectorDock
