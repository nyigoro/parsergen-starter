  let rightEdgeStrip = vnode("aside", attrs4(props_class("edge-strip right-edge-strip"), props_id("right-edge-strip"), props_attr("role", "tablist"), props_attr("aria-label", "Dock edge panes")), [
    edge_tab_button("edge-dock-tab-preview", "Preview", "dock", "preview", "right", "dock-panel-preview"),
    edge_tab_button("edge-dock-tab-problems", "Problems", "dock", "problems", "right", "dock-panel-problems"),
    edge_tab_button("edge-dock-tab-route", "Route", "dock", "route", "right", "dock-panel-route"),
    edge_tab_button("edge-dock-tab-packages", "Packages", "dock", "packages", "right", "dock-panel-packages"),
    edge_tab_button("edge-dock-tab-graph", "Graph", "dock", "graph", "right", "dock-panel-graph"),
    edge_tab_button("edge-dock-tab-compile", "Compile", "dock", "compile", "right", "dock-panel-compile"),
    edge_tab_button("edge-dock-tab-inspector", "Inspector", "dock", "inspector", "right", "dock-panel-inspector")
  ]);
  let bottomDrawerHeader = div_node("dock-group-header bottom-dock-header", [
    div_node("dock-group-heading", [
      vnode("div", props_class("panel-title"), [text("Output")]),
      vnode("span", attrs2(props_class("small-pill"), props_id("bottom-drawer-mode-pill")), [text("pinned")])
    ]),
    div_node("tool-row compact-tools", [
      tool_button("toggle-bottom-drawer-button", "Auto-hide", "secondary")
    ])
  ]);
  let bottomTabs = tab_list("dock-tabs bottom-drawer-tabs", "Output panes", [
    tab_button("drawer-tab-console", "Console", "drawer", "console", "drawer-panel-console"),
    tab_button("drawer-tab-events", "Route Events", "drawer", "events", "drawer-panel-events"),
    tab_button("drawer-tab-js", "Generated JS", "drawer", "js", "drawer-panel-js")
  ]);
  let bottomDrawerBody = div_node("bottom-drawer-body", [
    tab_panel("drawer-panel-console", "drawer-tab-console", "drawer-panel", [consolePanel]),
    tab_panel("drawer-panel-events", "drawer-tab-events", "drawer-panel", [routeEventsPanel]),
    tab_panel("drawer-panel-js", "drawer-tab-js", "drawer-panel", [jsPanel])
  ]);
  let bottomDrawer = vnode("section", attrs2(props_class("bottom-drawer dock-group"), props_id("bottom-drawer-shell")), [
    bottomDrawerHeader,
    bottomTabs,
    bottomDrawerBody
  ]);
  let bottomEdgeStrip = vnode("aside", attrs4(props_class("edge-strip bottom-edge-strip"), props_id("bottom-edge-strip"), props_attr("role", "tablist"), props_attr("aria-label", "Output edge panes")), [
    edge_tab_button("edge-drawer-tab-console", "Console", "drawer", "console", "bottom", "drawer-panel-console"),
    edge_tab_button("edge-drawer-tab-events", "Events", "drawer", "events", "bottom", "drawer-panel-events"),
    edge_tab_button("edge-drawer-tab-js", "Generated JS", "drawer", "js", "bottom", "drawer-panel-js")
  ]);
  let centerDockStack = div_node("center-dock-stack", [
    centerColumn,
    splitter("bottom-drawer-splitter", "horizontal", "bottom-drawer-shell", "horizontal", "Resize output pane"),
    bottomDrawer,
    bottomEdgeStrip
  ]);
  let workspace = div_node("ide-workbench dock-layout", [
    leftEdgeStrip,
    leftRail,
    splitter("left-rail-splitter", "vertical", "left-dock-group", "vertical", "Resize explorer pane"),
    centerDockStack,
    splitter("right-dock-splitter", "vertical", "right-dock-shell", "vertical", "Resize dock pane"),
    rightDock,
    rightEdgeStrip
  ]);
  let workspaceShell = div_node("workspace-shell", [toolbar, workspace]);

  let toast = vnode("div", attrs2(props_class("toast"), props_id("toast-root")), [text("")]);
  let dialogRoot = vnode("div", attrs2(props_class("dialog-root"), props_id("dialog-root")), [
    vnode("section", props_class("dialog-card"), [
      vnode("div", attrs2(props_class("dialog-title"), props_id("dialog-title")), [text("Action")]),
      vnode("p", attrs2(props_class("dialog-body"), props_id("dialog-body")), [text("")]),
      vnode("form", attrs2(props_class("dialog-form"), props_id("dialog-form")), [
        vnode("div", attrs2(props_class("dialog-fields"), props_id("dialog-fields-root")), []),
        vnode("p", attrs2(props_class("dialog-error"), props_id("dialog-error")), [text("")]),
        div_node("dialog-actions", [
          tool_button("dialog-cancel-button", "Cancel", "secondary"),
          tool_button("dialog-submit-button", "Confirm", "primary")
        ])
      ])
    ])
  ]);
  let body = div_node("playground-body", [header, workspaceShell, toast, dialogRoot]);
  return div_node("playground-shell", [body]);
}
