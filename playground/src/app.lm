import {
  vnode,
  text,
  props_class,
  props_id,
  props_href,
  props_merge,
  props_type,
  props_value,
  props_placeholder,
  props_disabled,
  props_attr
} from "@std/render";

fn attrs2(left: any, right: any) -> any {
  props_merge(left, right)
}

fn attrs3(first: any, second: any, third: any) -> any {
  props_merge(props_merge(first, second), third)
}

fn attrs4(first: any, second: any, third: any, fourth: any) -> any {
  props_merge(props_merge(props_merge(first, second), third), fourth)
}

fn attrs5(first: any, second: any, third: any, fourth: any, fifth: any) -> any {
  props_merge(props_merge(props_merge(props_merge(first, second), third), fourth), fifth)
}

fn div_node(cls: string, children: any) -> VNode {
  vnode("div", props_class(cls), children)
}

fn panel(title: string, bodyId: string, bodyClass: string) -> VNode {
  let heading = vnode("div", props_class("panel-title"), [text(title)]);
  let body = vnode("div", attrs2(props_class(bodyClass), props_id(bodyId)), []);
  vnode("section", props_class("panel"), [heading, body])
}

fn tool_button(id: string, label: string, tone: string) -> VNode {
  vnode(
    "button",
    attrs3(
      props_class("tool-button " + tone),
      props_id(id),
      props_type("button")
    ),
    [text(label)]
  )
}

fn disabled_tool_button(id: string, label: string, tone: string) -> VNode {
  vnode(
    "button",
    attrs4(
      props_class("tool-button " + tone),
      props_id(id),
      props_type("button"),
      props_disabled(true)
    ),
    [text(label)]
  )
}

fn preset_button(id: string, label: string, detail: string) -> VNode {
  let labelNode = vnode("span", props_class("preset-label"), [text(label)]);
  let detailNode = vnode("span", props_class("preset-detail"), [text(detail)]);
  vnode(
    "button",
    attrs2(
      props_class("preset-button"),
      props_id("preset-" + id)
    ),
    [labelNode, detailNode]
  )
}

fn link_node(id: string, cls: string, href: string, label: string) -> VNode {
  vnode("a", attrs3(props_class(cls), props_id(id), props_href(href)), [text(label)])
}

fn stat(label: string, value: string, id: string) -> VNode {
  let top = vnode("span", props_class("stat-label"), [text(label)]);
  let bottom = vnode("span", attrs2(props_class("stat-value"), props_id(id)), [text(value)]);
  div_node("stat", [top, bottom])
}

fn insight_row(label: string, value: string, id: string) -> VNode {
  let keyNode = vnode("span", props_class("insight-key"), [text(label)]);
  let valueNode = vnode("span", attrs2(props_class("insight-value"), props_id(id)), [text(value)]);
  div_node("insight-row", [keyNode, valueNode])
}

fn field_label(label: string) -> VNode {
  vnode("span", props_class("route-field-label"), [text(label)])
}

fn text_input(id: string, placeholder: string) -> VNode {
  vnode(
    "input",
    attrs5(
      props_class("route-input"),
      props_id(id),
      props_type("text"),
      props_value(""),
      props_placeholder(placeholder)
    ),
    []
  )
}

fn plain_input(id: string, value: string, placeholder: string, cls: string) -> VNode {
  vnode(
    "input",
    attrs5(
      props_class(cls),
      props_id(id),
      props_type("text"),
      props_value(value),
      props_placeholder(placeholder)
    ),
    []
  )
}

fn dock_summary(label: string, detail: string) -> VNode {
  vnode("summary", props_class("dock-summary"), [
    vnode("span", props_class("dock-summary-label"), [text(label)]),
    vnode("span", props_class("dock-summary-detail"), [text(detail)])
  ])
}

fn open_dock(label: string, detail: string, cls: string, children: any) -> VNode {
  vnode(
    "details",
    attrs2(props_class("dock-section " + cls), props_attr("open", true)),
    [dock_summary(label, detail), div_node("dock-section-body", children)]
  )
}

pub fn app() -> VNode {
  let brandMark = vnode("span", props_class("brand-mark"), [text("L")]);
  let brandTitle = vnode("strong", props_class("brand-title"), [text("Lumina Playground")]);
  let brandSubtitle = vnode("span", props_class("brand-subtitle"), [text("v0.5.7")]);
  let brandCopy = div_node("brand-copy", [brandTitle, brandSubtitle]);
  let brand = div_node("brand", [
    brandMark,
    brandCopy
  ]);

  let homeLink = link_node("home-link", "top-link", "../", "Home");
  let docsLink = link_node("docs-link", "top-link", "../docs/", "Docs");
  let githubLink = link_node("github-link", "top-link primary", "https://github.com/nyigoro/lumina-lang", "GitHub");
  let nav = vnode("nav", props_class("top-links"), [
    homeLink,
    docsLink,
    githubLink
  ]);

  let header = vnode("header", props_class("topbar"), [brand, nav]);

  let runButton = tool_button("run-button", "Run", "primary");
  let stopButton = disabled_tool_button("stop-run-button", "Stop", "secondary");
  let stopCompileButton = disabled_tool_button("stop-compile-button", "Stop Compile", "secondary");
  let checkButton = tool_button("check-button", "Check", "secondary");
  let formatButton = tool_button("format-button", "Format", "secondary");
  let shareButton = tool_button("share-button", "Share", "secondary");
  let copyButton = tool_button("copy-js-button", "Copy JS", "secondary");
  let toolRow = div_node("tool-row", [
    runButton,
    stopButton,
    stopCompileButton,
    checkButton,
    formatButton,
    shareButton,
    copyButton
  ]);

  let statusStat = stat("Compile", "Waiting", "compile-status");
  let diagnosticStat = stat("Diagnostics", "0", "diagnostic-count");
  let outputStat = stat("Output", "JS", "output-mode");
  let activeFileStat = stat("Active File", "main.lm", "active-file-stat");
  let status = div_node("status-strip", [
    statusStat,
    diagnosticStat,
    outputStat,
    activeFileStat
  ]);

  let toolbar = div_node("workspace-toolbar", [toolRow, status]);

  let basicsPreset = preset_button("basics", "Basics", "Functions and return values");
  let indexingPreset = preset_button("safe-index", "Safe Indexing", "Option instead of undefined");
  let iteratorsPreset = preset_button("iterators", "Iterators", "Vec map, fold, and match");
  let resultsPreset = preset_button("results", "Results", "Error flow with Result");
  let viewPreset = preset_button("view-basic", "View", "DOM-shaped render output");
  let keyedPreset = preset_button("keyed-ui", "Keyed UI", "Stable list identity and SSR keys");
  let genericKeyedPreset = preset_button("generic-keyed-ui", "Generic Keys", "Manual panel and branch identity");
  let starterPreset = preset_button("starter-app", "Starter App", "Router, loader, and multi-file shell");
  let formsPreset = preset_button("forms-resource", "Forms + Resource", "Validation and optimistic actions");
  let packagePreset = preset_button("package-import", "Package Import", "Bare package resolution");
  let presets = div_node("preset-grid", [
    basicsPreset,
    indexingPreset,
    iteratorsPreset,
    resultsPreset,
    viewPreset,
    keyedPreset,
    genericKeyedPreset,
    starterPreset,
    formsPreset,
    packagePreset
  ]);
  let presetPanel = vnode("section", props_class("panel rail-card preset-panel"), [
    div_node("panel-heading-row", [
      vnode("div", props_class("panel-title"), [text("Presets")]),
      vnode("span", props_class("small-pill"), [text("examples")])
    ]),
    presets
  ]);

  let workspaceHeading = vnode("div", props_class("panel-title"), [text("Workspace")]);
  let workspaceInput = plain_input("workspace-name-input", "", "starter-app", "workspace-input");
  let workspaceControls = div_node("tool-row compact-tools", [
    tool_button("save-workspace-button", "Save", "secondary"),
    tool_button("save-workspace-as-button", "Save As", "secondary"),
    tool_button("rename-workspace-button", "Rename", "secondary"),
    tool_button("delete-workspace-button", "Delete", "secondary"),
    tool_button("export-workspace-button", "Export", "secondary"),
    tool_button("import-workspace-button", "Import", "secondary"),
    tool_button("scaffold-package-button", "Scaffold Package", "secondary"),
    tool_button("reset-workspace-button", "Reset", "secondary")
  ]);
  let workspaceRecent = vnode("div", attrs2(props_class("workspace-recent-list"), props_id("recent-workspaces-root")), []);
  let workspacePanel = vnode("section", props_class("workspace-manager panel"), [
    div_node("panel-heading-row", [workspaceHeading, vnode("span", attrs2(props_class("small-pill"), props_id("workspace-status-pill")), [text("local")])]),
    workspaceInput,
    workspaceControls,
    workspaceRecent
  ]);

  let sourceTitle = vnode("div", props_class("panel-title"), [text("Project")]);
  let sourceSize = vnode("span", attrs2(props_class("small-pill"), props_id("source-size")), [text("0 lines")]);
  let editorTop = div_node("panel-heading-row", [
    sourceTitle,
    sourceSize
  ]);

  let fileHeader = div_node("panel-heading-row file-heading-row", [
    vnode("div", props_class("panel-title"), [text("Files")]),
    div_node("tool-row compact-tools", [
      tool_button("new-file-button", "New File", "secondary"),
      tool_button("rename-file-button", "Rename", "secondary"),
      tool_button("duplicate-file-button", "Duplicate", "secondary"),
      tool_button("set-entry-button", "Set Entry", "secondary"),
      tool_button("delete-file-button", "Delete File", "secondary")
    ])
  ]);
  let fileList = vnode("div", attrs2(props_class("file-list"), props_id("file-list-root")), []);
  let fileSidebar = vnode("aside", props_class("file-sidebar"), [fileHeader, fileList]);
  let leftRail = vnode("aside", props_class("left-rail"), [
    workspacePanel,
    fileSidebar,
    presetPanel
  ]);

  let activeFile = vnode("span", attrs2(props_class("small-pill"), props_id("active-file-label")), [text("main.lm")]);
  let entryFile = vnode("span", attrs2(props_class("small-pill"), props_id("entry-file-label")), [text("entry: main.lm")]);
  let editorHeader = div_node("panel-heading-row", [
    vnode("div", props_class("panel-title"), [text("Editor")]),
    div_node("panel-heading-row editor-pill-row", [entryFile, activeFile])
  ]);
  let fileTabs = vnode("div", attrs2(props_class("file-tabs"), props_id("file-tabs-root")), []);
  let editorMount = vnode("div", props_id("editor-root"), []);
  let editorPanel = vnode("section", props_class("editor-panel main-editor-panel"), [
    editorTop,
    editorHeader,
    fileTabs,
    editorMount
  ]);
  let centerColumn = div_node("center-editor", [toolbar, editorPanel]);

  let routeHeader = div_node("panel-heading-row", [
    vnode("div", props_class("panel-title"), [text("Route Preview")]),
    vnode("span", attrs2(props_class("small-pill"), props_id("route-preview-url")), [text("/")])
  ]);
  let routeFields = div_node("route-field-grid", [
    div_node("route-field", [field_label("Path"), text_input("route-path-input", "/dashboard")]),
    div_node("route-field", [field_label("Search"), text_input("route-search-input", "?tab=team")]),
    div_node("route-field", [field_label("Hash"), text_input("route-hash-input", "#activity")])
  ]);
  let routeButtons = div_node("tool-row compact-tools", [
    tool_button("route-apply-button", "Apply", "secondary"),
    tool_button("route-push-button", "Push", "secondary"),
    tool_button("route-replace-button", "Replace", "secondary"),
    tool_button("route-back-button", "Back", "secondary"),
    tool_button("route-forward-button", "Forward", "secondary"),
    tool_button("route-reset-button", "Reset", "secondary")
  ]);
  let routePanel = vnode("section", props_class("panel route-panel"), [
    routeHeader,
    routeFields,
    routeButtons
  ]);
  let routeInspectorPanel = panel("Route Inspector", "route-details-root", "debug-list");
  let routeEventsPanel = panel("Route Events", "route-events-root", "route-events-list");

  let consoleHeading = vnode("div", props_class("panel-title"), [text("Console")]);
  let consoleStatus = vnode("span", attrs2(props_class("small-pill"), props_id("run-status")), [text("Not run")]);
  let consoleTitle = div_node("panel-heading-row", [
    consoleHeading,
    consoleStatus
  ]);
  let consoleOutput = vnode("pre", attrs2(props_class("console-output"), props_id("console-root")), [text("")]);
  let consolePanel = vnode("section", props_class("panel"), [consoleTitle, consoleOutput]);

  let diagnosticsPanel = panel("Diagnostics", "diagnostics-root", "diagnostics-list");
  let debugPanel = panel("Import Graph", "module-graph-root", "debug-list");
  let compilePanel = panel("Compile Details", "compile-details-root", "debug-list");
  let packagePanel = panel("Packages", "package-details-root", "debug-list");
  let jsTitle = vnode("div", props_class("panel-title"), [text("Generated JavaScript")]);
  let jsBadge = vnode("span", props_class("small-pill"), [text("ES module")]);
  let jsHeader = div_node("panel-heading-row", [jsTitle, jsBadge]);
  let jsOutput = vnode("pre", attrs2(props_class("js-output"), props_id("output-root")), [text("")]);
  let jsPanel = vnode("section", props_class("panel js-panel"), [
    jsHeader,
    jsOutput
  ]);

  let insightTitle = vnode("div", props_class("insight-title"), [text("Workbench")]);
  let compileRow = insight_row("Compile", "Browser", "insight-compile");
  let startupRow = insight_row("Startup", "warming", "insight-startup");
  let workerRow = insight_row("Worker", "booting", "insight-worker");
  let runRow = insight_row("Run", "main()", "insight-run");
  let shareRow = insight_row("Share", "Project URL", "insight-share");
  let targetRow = insight_row("Modules", "0", "insight-modules");
  let debugRow = insight_row("Graph", "0 edges", "insight-graph");
  let bundleRow = insight_row("Bundle", "0 KB", "insight-bundle");
  let workspaceRow = insight_row("Workspace", "ephemeral", "insight-workspace");
  let insightPanel = vnode("aside", props_class("insight-panel"), [
    insightTitle,
    compileRow,
    startupRow,
    workerRow,
    runRow,
    shareRow,
    targetRow,
    debugRow,
    bundleRow,
    workspaceRow
  ]);

  let dockTabs = div_node("dock-tabs", [
    vnode("span", props_class("small-pill"), [text("Preview")]),
    vnode("span", props_class("small-pill"), [text("Diagnostics")]),
    vnode("span", props_class("small-pill"), [text("Route")]),
    vnode("span", props_class("small-pill"), [text("Packages")]),
    vnode("span", props_class("small-pill"), [text("Inspector")])
  ]);
  let previewDock = open_dock("Preview", "route sandbox", "preview-dock", [routePanel]);
  let diagnosticsDock = open_dock("Diagnostics", "compile feedback", "diagnostics-dock", [diagnosticsPanel]);
  let routeDock = open_dock("Route", "state and matches", "route-dock", [routeInspectorPanel]);
  let packageDock = open_dock("Packages", "imports and locks", "packages-dock", [packagePanel]);
  let inspectorDock = open_dock("Inspector", "compile graph", "inspector-dock", [debugPanel, compilePanel, insightPanel]);
  let rightDock = vnode("aside", props_class("right-dock"), [
    dockTabs,
    previewDock,
    diagnosticsDock,
    routeDock,
    packageDock,
    inspectorDock
  ]);
  let bottomDrawer = open_dock("Output", "console, route events, generated JS", "bottom-drawer", [
    consolePanel,
    routeEventsPanel,
    jsPanel
  ]);
  let workspace = div_node("ide-workbench", [leftRail, centerColumn, rightDock]);

  let toast = vnode("div", attrs2(props_class("toast"), props_id("toast-root")), [text("")]);
  let dialogRoot = vnode("div", attrs2(props_class("dialog-root"), props_id("dialog-root")), [
    vnode("section", props_class("dialog-card"), [
      vnode("div", attrs2(props_class("dialog-title"), props_id("dialog-title")), [text("Action")]),
      vnode("p", attrs2(props_class("dialog-body"), props_id("dialog-body")), [text("")]),
      vnode("form", attrs2(props_class("dialog-form"), props_id("dialog-form")), [
        vnode("div", attrs2(props_class("dialog-fields"), props_id("dialog-fields-root")), []),
        vnode("p", attrs2(props_class("dialog-error"), props_id("dialog-error")), [text("")]),
        div_node("dialog-actions", [
          tool_button("dialog-cancel-button", "Cancel", "secondary"),
          tool_button("dialog-submit-button", "Confirm", "primary")
        ])
      ])
    ])
  ]);
  let body = div_node("playground-body", [header, workspace, bottomDrawer, toast, dialogRoot]);
  return div_node("playground-shell", [body]);
}
