import {
  vnode,
  text,
  props_class,
  props_id,
  props_href,
  props_merge,
  props_type,
  props_value,
  props_placeholder,
  props_disabled,
  props_attr
} from "@std/render";

fn attrs2(left: any, right: any) -> any {
  props_merge(left, right)
}

fn attrs3(first: any, second: any, third: any) -> any {
  props_merge(props_merge(first, second), third)
}

fn attrs4(first: any, second: any, third: any, fourth: any) -> any {
  props_merge(props_merge(props_merge(first, second), third), fourth)
}

fn attrs5(first: any, second: any, third: any, fourth: any, fifth: any) -> any {
  props_merge(props_merge(props_merge(props_merge(first, second), third), fourth), fifth)
}

fn attrs6(first: any, second: any, third: any, fourth: any, fifth: any, sixth: any) -> any {
  props_merge(attrs5(first, second, third, fourth, fifth), sixth)
}

fn attrs7(first: any, second: any, third: any, fourth: any, fifth: any, sixth: any, seventh: any) -> any {
  props_merge(attrs6(first, second, third, fourth, fifth, sixth), seventh)
}

fn attrs8(first: any, second: any, third: any, fourth: any, fifth: any, sixth: any, seventh: any, eighth: any) -> any {
  props_merge(attrs7(first, second, third, fourth, fifth, sixth, seventh), eighth)
}

fn div_node(cls: string, children: any) -> VNode {
  vnode("div", props_class(cls), children)
}

fn panel(title: string, bodyId: string, bodyClass: string) -> VNode {
  let heading = vnode("div", props_class("panel-title"), [text(title)]);
  let body = vnode("div", attrs2(props_class(bodyClass), props_id(bodyId)), []);
  vnode("section", props_class("panel stack-sm"), [heading, body])
}

fn tool_button(id: string, label: string, tone: string) -> VNode {
  vnode(
    "button",
    attrs3(
      props_class("tool-button " + tone),
      props_id(id),
      props_type("button")
    ),
    [text(label)]
  )
}

fn disabled_tool_button(id: string, label: string, tone: string) -> VNode {
  vnode(
    "button",
    attrs4(
      props_class("tool-button " + tone),
      props_id(id),
      props_type("button"),
      props_disabled(true)
    ),
    [text(label)]
  )
}

fn preset_button(id: string, label: string, detail: string) -> VNode {
  let labelNode = vnode("span", props_class("preset-label"), [text(label)]);
  let detailNode = vnode("span", props_class("preset-detail"), [text(detail)]);
  vnode(
    "button",
    attrs2(
      props_class("preset-button"),
      props_id("preset-" + id)
    ),
    [labelNode, detailNode]
  )
}

fn link_node(id: string, cls: string, href: string, label: string) -> VNode {
  vnode("a", attrs3(props_class(cls), props_id(id), props_href(href)), [text(label)])
}

fn stat(label: string, value: string, id: string) -> VNode {
  let top = vnode("span", props_class("stat-label"), [text(label)]);
  let bottom = vnode("span", attrs2(props_class("stat-value"), props_id(id)), [text(value)]);
  div_node("stat", [top, bottom])
}

fn insight_row(label: string, value: string, id: string) -> VNode {
  let keyNode = vnode("span", props_class("insight-key"), [text(label)]);
  let valueNode = vnode("span", attrs2(props_class("insight-value"), props_id(id)), [text(value)]);
  div_node("insight-row", [keyNode, valueNode])
}

fn field_label(label: string) -> VNode {
  vnode("span", props_class("route-field-label"), [text(label)])
}

fn text_input(id: string, placeholder: string) -> VNode {
  vnode(
    "input",
    attrs5(
      props_class("route-input"),
      props_id(id),
      props_type("text"),
      props_value(""),
      props_placeholder(placeholder)
    ),
    []
  )
}

fn plain_input(id: string, value: string, placeholder: string, cls: string) -> VNode {
  vnode(
    "input",
    attrs5(
      props_class(cls),
      props_id(id),
      props_type("text"),
      props_value(value),
      props_placeholder(placeholder)
    ),
    []
  )
}

fn tab_list(cls: string, label: string, children: any) -> VNode {
  vnode(
    "div",
    attrs3(
      props_class(cls),
      props_attr("role", "tablist"),
      props_attr("aria-label", label)
    ),
    children
  )
}

fn tab_panel(id: string, labelledBy: string, cls: string, children: any) -> VNode {
  vnode(
    "section",
    attrs4(
      props_class(cls),
      props_id(id),
      props_attr("role", "tabpanel"),
      props_attr("aria-labelledby", labelledBy)
    ),
    children
  )
}

fn splitter(id: string, orientation: string, controls: string, cls: string, label: string) -> VNode {
  vnode(
    "div",
    attrs7(
      props_class("layout-splitter " + cls),
      props_id(id),
      props_attr("role", "separator"),
      props_attr("aria-orientation", orientation),
      props_attr("aria-controls", controls),
      props_attr("aria-label", label),
      props_attr("tabindex", "0")
    ),
    []
  )
}

fn tab_button(id: string, label: string, tabGroup: string, value: string, controls: string) -> VNode {
  vnode(
    "button",
    attrs8(
      props_class("tool-button secondary layout-tab-button"),
      props_id(id),
      props_type("button"),
      props_attr("data-tab-group", tabGroup),
      props_attr("data-tab-value", value),
      props_attr("role", "tab"),
      props_attr("aria-selected", "false"),
      props_attr("aria-controls", controls)
    ),
    [text(label)]
  )
}

fn edge_tab_button(id: string, label: string, tabGroup: string, value: string, edge: string, controls: string) -> VNode {
  vnode(
    "button",
    attrs8(
      props_class("edge-tab-button edge-tab-button-" + edge),
      props_id(id),
      props_type("button"),
      props_attr("data-tab-group", tabGroup),
      props_attr("data-tab-value", value),
      props_attr("role", "tab"),
      props_attr("aria-selected", "false"),
      props_attr("aria-controls", controls)
    ),
    [text(label)]
  )
}

pub fn app() -> VNode {
  let brandMark = vnode("span", props_class("brand-mark"), [text("L")]);
  let brandTitle = vnode("strong", props_class("brand-title"), [text("Lumina Playground")]);
  let brandSubtitle = vnode("span", props_class("brand-subtitle"), [text("v0.5.7")]);
  let brandCopy = div_node("brand-copy", [brandTitle, brandSubtitle]);
  let brand = div_node("brand", [
    brandMark,
    brandCopy
  ]);

  let homeLink = link_node("home-link", "top-link", "../", "Home");
  let docsLink = link_node("docs-link", "top-link", "../docs/", "Docs");
  let githubLink = link_node("github-link", "top-link primary", "https://github.com/nyigoro/lumina-lang", "GitHub");
  let nav = vnode("nav", props_class("top-links"), [
    homeLink,
    docsLink,
    githubLink
  ]);

  let header = vnode("header", props_class("topbar"), [brand, nav]);

  let runButton = tool_button("run-button", "Run", "primary");
  let stopButton = disabled_tool_button("stop-run-button", "Stop", "secondary");
  let stopCompileButton = disabled_tool_button("stop-compile-button", "Stop Compile", "secondary");
  let checkButton = tool_button("check-button", "Check", "secondary");
  let formatButton = tool_button("format-button", "Format", "secondary");
  let shareButton = tool_button("share-button", "Share", "secondary");
  let copyButton = tool_button("copy-js-button", "Copy JS", "secondary");
  let toggleExplorerButton = tool_button("toggle-left-rail-toolbar-button", "Explorer", "secondary");
  let toggleDockButton = tool_button("toggle-right-dock-toolbar-button", "Dock", "secondary");
  let toggleOutputButton = tool_button("toggle-bottom-drawer-toolbar-button", "Output", "secondary");
  let actionRow = div_node("tool-row toolbar-row toolbar-row-primary", [
    runButton,
    stopButton,
    stopCompileButton,
    checkButton,
    formatButton,
    shareButton,
    copyButton
  ]);

  let layoutLabel = vnode("span", props_class("toolbar-label"), [text("Panels")]);
  let layoutRow = div_node("tool-row toolbar-row toolbar-row-secondary", [
    layoutLabel,
    toggleExplorerButton,
    toggleDockButton,
    toggleOutputButton
  ]);

  let statusStat = stat("Compile", "Waiting", "compile-status");
  let diagnosticStat = stat("Diagnostics", "0", "diagnostic-count");
  let outputStat = stat("Output", "JS", "output-mode");
  let activeFileStat = stat("Active File", "main.lm", "active-file-stat");
  let status = div_node("status-strip stack-sm", [
    statusStat,
    diagnosticStat,
    outputStat,
    activeFileStat
  ]);

  let toolbar = div_node("workspace-toolbar", [actionRow, layoutRow, status]);

  let basicsPreset = preset_button("basics", "Basics", "Functions and return values");
  let indexingPreset = preset_button("safe-index", "Safe Indexing", "Option instead of undefined");
  let iteratorsPreset = preset_button("iterators", "Iterators", "Vec map, fold, and match");
  let resultsPreset = preset_button("results", "Results", "Error flow with Result");
  let viewPreset = preset_button("view-basic", "View", "DOM-shaped render output");
  let keyedPreset = preset_button("keyed-ui", "Keyed UI", "Stable list identity and SSR keys");
  let genericKeyedPreset = preset_button("generic-keyed-ui", "Generic Keys", "Manual panel and branch identity");
  let starterPreset = preset_button("starter-app", "Starter App", "Router, loader, and multi-file shell");
  let formsPreset = preset_button("forms-resource", "Forms + Resource", "Validation and optimistic actions");
  let packagePreset = preset_button("package-import", "Package Import", "Bare package resolution");
  let presets = div_node("preset-grid", [
    basicsPreset,
    indexingPreset,
    iteratorsPreset,
    resultsPreset,
    viewPreset,
    keyedPreset,
    genericKeyedPreset,
    starterPreset,
    formsPreset,
    packagePreset
  ]);
  let presetPanel = tab_panel("rail-presets-panel", "rail-tab-presets", "panel rail-card preset-panel rail-panel", [
    div_node("panel-heading-row", [
      vnode("div", props_class("panel-title"), [text("Presets")]),
      vnode("span", props_class("small-pill"), [text("examples")])
    ]),
    presets
  ]);

  let workspaceHeading = vnode("div", props_class("panel-title"), [text("Workspace")]);
  let workspaceInput = plain_input("workspace-name-input", "", "starter-app", "workspace-input");
  let workspaceControls = div_node("tool-row compact-tools", [
    tool_button("save-workspace-button", "Save", "secondary"),
    tool_button("save-workspace-as-button", "Save As", "secondary"),
    tool_button("rename-workspace-button", "Rename", "secondary"),
    tool_button("delete-workspace-button", "Delete", "secondary"),
    tool_button("export-workspace-button", "Export", "secondary"),
    tool_button("import-workspace-button", "Import", "secondary"),
    tool_button("scaffold-package-button", "Scaffold Package", "secondary"),
    tool_button("reset-workspace-button", "Reset", "secondary")
  ]);
  let workspaceRecent = vnode("div", attrs3(props_class("workspace-recent-list"), props_id("recent-workspaces-root"), props_attr("role", "list")), []);
  let workspacePanel = tab_panel("rail-workspace-panel", "rail-tab-workspace", "workspace-manager panel rail-panel stack-sm", [
    div_node("panel-heading-row", [workspaceHeading, vnode("span", attrs2(props_class("small-pill"), props_id("workspace-status-pill")), [text("local")])]),
    workspaceInput,
    workspaceControls,
    workspaceRecent
  ]);

  let sourceTitle = vnode("div", props_class("panel-title"), [text("Editor")]);
  let sourceSize = vnode("span", attrs2(props_class("small-pill"), props_id("source-size")), [text("0 lines")]);
  let editorTop = div_node("panel-heading-row", [
    sourceTitle,
    div_node("panel-heading-row editor-pill-row", [sourceSize])
  ]);

  let fileHeader = div_node("panel-heading-row file-heading-row", [
    vnode("div", props_class("panel-title"), [text("Files")]),
    div_node("tool-row compact-tools", [
      tool_button("new-file-button", "New", "secondary"),
      tool_button("rename-file-button", "Rename", "secondary"),
      tool_button("duplicate-file-button", "Duplicate", "secondary"),
      tool_button("set-entry-button", "Entry", "secondary"),
      tool_button("delete-file-button", "Delete", "secondary")
    ])
  ]);
  let fileList = vnode("div", attrs3(props_class("file-list"), props_id("file-list-root"), props_attr("role", "list")), []);
  let fileSidebar = tab_panel("rail-files-panel", "rail-tab-files", "file-sidebar panel rail-panel stack-sm", [fileHeader, fileList]);
  let leftRailHeader = div_node("dock-group-header", [
    div_node("dock-group-heading", [
      vnode("div", props_class("panel-title"), [text("Explorer")]),
