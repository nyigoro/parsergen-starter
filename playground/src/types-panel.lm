import { vnode, text, props_class, props_id, props_merge } from "@std/render";

fn attrs2(left: any, right: any) -> any {
  props_merge(left, right)
}

pub fn types_panel() -> VNode {
  vnode("section", attrs2(props_class("panel stack-sm"), props_id("types-panel")), [
    vnode("div", props_class("panel-title"), [text("Types")]),
    vnode("p", props_class("empty-state"), [text("Type inspection is a Phase 1 placeholder.")])
  ])
}
