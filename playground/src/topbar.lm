import {
  vnode,
  text,
  props_class,
  props_id,
  props_href,
  props_merge,
  props_type,
  props_attr
} from "@std/render";

fn attrs2(left: any, right: any) -> any {
  props_merge(left, right)
}

fn attrs3(first: any, second: any, third: any) -> any {
  props_merge(props_merge(first, second), third)
}

fn attrs4(first: any, second: any, third: any, fourth: any) -> any {
  props_merge(attrs3(first, second, third), fourth)
}

fn button_node(id: string, label: string, cls: string) -> VNode {
  vnode("button", attrs3(props_class(cls), props_id(id), props_type("button")), [text(label)])
}

pub fn topbar() -> VNode {
  let brandMark = vnode("span", props_class("brand-mark"), [text("L")]);
  let brandTitle = vnode("strong", props_class("brand-title"), [text("Lumina Playground")]);
  let brandSubtitle = vnode("span", props_class("brand-subtitle"), [text("v0.5.7")]);
  let brand = vnode("div", props_class("brand"), [
    brandMark,
    vnode("div", props_class("brand-copy"), [brandTitle, brandSubtitle])
  ]);

  let examples = vnode(
    "div",
    props_class("examples-browser-shell"),
    [
      vnode(
        "button",
        attrs4(
          props_class("tool-button secondary examples-toggle"),
          props_id("examples-toggle"),
          props_type("button"),
          props_attr("aria-haspopup", "true")
        ),
        [
          vnode("span", props_class("examples-toggle-label"), [text("Examples")]),
          vnode("span", props_id("examples-current"), [text("Functions")])
        ]
      ),
      vnode("div", attrs3(props_class("examples-browser"), props_id("examples-browser-root"), props_attr("hidden", "")), [])
    ]
  );

  let modes = vnode("div", props_class("tool-row compact-tools"), [
    button_node("run-button", "Run", "tool-button primary"),
    button_node("mode-check-button", "Check", "tool-button secondary"),
    button_node("format-button", "Format", "tool-button secondary")
  ]);

  let targets = vnode("div", props_class("tool-row compact-tools"), [
    button_node("target-js-button", "JS", "tool-button secondary"),
    button_node("target-wasm-button", "WASM", "tool-button secondary"),
    button_node("target-both-button", "Both", "tool-button secondary")
  ]);

  let actions = vnode("div", props_class("tool-row compact-tools"), [
    button_node("settings-button", "Settings", "tool-button secondary"),
    button_node("share-button", "Share", "tool-button secondary"),
    button_node("copy-embed-button", "Embed", "tool-button secondary"),
    button_node("open-playground-button", "Open in Playground", "tool-button secondary embed-only"),
    vnode("a", attrs3(props_class("top-link"), props_id("docs-link"), props_href("../docs/")), [text("Docs")])
  ]);

  vnode("header", attrs2(props_class("topbar"), props_attr("style", "display:flex;gap:1rem;align-items:center;")), [
    brand,
    vnode("div", attrs2(props_class("tool-row toolbar-row"), props_attr("style", "justify-content:end;align-items:center;gap:0.75rem;")), [examples, modes, targets, actions])
  ])
}
