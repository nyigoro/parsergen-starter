import {
  vnode,
  text,
  props_class,
  props_id,
  props_type,
  props_attr,
  props_merge
} from "@std/render";

fn attrs3(first: any, second: any, third: any) -> any {
  props_merge(props_merge(first, second), third)
}

pub fn diagnostics_panel() -> VNode {
  vnode("section", attrs3(props_class("panel stack-sm"), props_id("diagnostics-panel"), props_attr("style", "margin-top:0.625rem;")), [
    vnode("button", attrs3(props_class("tool-button secondary"), props_id("diagnostics-toggle"), props_type("button")), [
      text("Diagnostics "),
      vnode("span", props_id("diagnostics-count-label"), [text("0")])
    ]),
    vnode("div", attrs3(props_class("diagnostics-list"), props_id("diagnostics-root"), props_attr("aria-live", "polite")), []),
    vnode("div", attrs3(props_class("debug-list"), props_id("diagnostic-explain-root"), props_attr("hidden", "true")), [])
  ])
}
