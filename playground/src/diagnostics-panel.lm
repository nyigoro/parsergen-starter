import {
  vnode,
  text,
  props_class,
  props_id,
  props_attr,
  props_merge
} from "@std/render";

fn attrs3(first: any, second: any, third: any) -> any {
  props_merge(props_merge(first, second), third)
}

pub fn diagnostics_panel() -> VNode {
  vnode("section", attrs3(props_class("panel stack-sm diagnostics-panel"), props_id("diagnostics-panel"), props_attr("style", "min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);overflow:hidden;")), [
    vnode("div", props_class("panel-heading-row"), [
      vnode("div", props_class("panel-title"), [text("Diagnostics")]),
      vnode("span", attrs3(props_class("small-pill"), props_id("diagnostics-count-label"), props_attr("aria-live", "polite")), [text("0 errors / 0 warnings")])
    ]),
    vnode("div", props_class("diagnostics-body"), [
      vnode("div", attrs3(props_class("diagnostics-list"), props_id("diagnostics-root"), props_attr("aria-live", "polite")), []),
      vnode("div", attrs3(props_class("debug-list"), props_id("diagnostic-explain-root"), props_attr("hidden", "true")), [])
    ])
  ])
}
