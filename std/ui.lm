pub fn input(props: any) -> VNode {
  vnode(
    "input",
    props_merge(
      props_class("w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-100"),
      props
    ),
    []
  )
}

fn input_variant_class(variant: string) -> string {
  if (variant == "error") {
    return "w-full rounded-lg border border-rose-400 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:ring-2 focus:ring-rose-100"
  }
  if (variant == "quiet") {
    return "w-full rounded-lg border border-transparent bg-slate-100 px-3 py-2 text-sm text-slate-900 outline-none focus:bg-white focus:ring-2 focus:ring-sky-100"
  }
  return "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-sky-400 focus:ring-2 focus:ring-sky-100"
}

pub fn inputVariant(variant: string, props: any) -> VNode {
  vnode("input", props_merge(props_class(input_variant_class(variant)), props), [])
}

pub fn field(props: any, children: any) -> VNode {
  vnode(
    "div",
    props_merge(
      props_class("grid gap-2"),
