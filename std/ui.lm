      props
    ),
    children
  )
}

pub fn appHeader(props: any, children: any) -> VNode {
  vnode(
    "header",
    props_merge(
      props_class("sticky top-0 z-10 flex min-h-14 items-center border-b border-slate-200 bg-white/95 px-4"),
      props
    ),
    children
  )
}

pub fn appSidebar(props: any, children: any) -> VNode {
  vnode(
    "aside",
    props_merge(
      props_class("border-r border-slate-200 bg-white px-3 py-4"),
      props
    ),
