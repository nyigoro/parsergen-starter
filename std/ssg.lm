import { render } from "@std";

pub fn page(body: any, options: any) -> string {
  render.ssgPage(body, options)
}

pub fn hydrationOptions(state: any, hydrateModule: string) -> any {
  render.props_merge(render.props_attr("hydrationState", state), render.props_attr("hydrateModule", hydrateModule))
}

pub fn serializedStateOptions(state: any, options: any) -> any {
  render.props_merge(options, render.props_attr("serializedState", state))
}

pub fn loaderStateOptions(state: any, options: any) -> any {
  render.props_merge(options, render.props_attr("loaderState", state))
}

pub fn hydrationBoundaryOptions(state: any, hydrateModule: string, boundary: string) -> any {
  render.props_merge(hydrationOptions(state, hydrateModule), render.props_attr("hydrationBoundary", boundary))
}

pub fn requestOptions(requestId: string, options: any) -> any {
  render.props_merge(options, render.props_attr("requestId", requestId))
}

pub fn deferredDataOptions(state: any, options: any) -> any {
  render.props_merge(options, render.props_attr("deferredData", state))
}

pub fn islandStateOptions(state: any, options: any) -> any {
  render.props_merge(options, render.props_attr("islandState", state))
}

pub fn islandProps(id: string, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_attr("data-lumina-island", id),
      render.props_attr("data-lumina-hydration", "island")
    )
  )
}

pub fn deferredHydrationProps(id: string, props: any) -> any {
  render.props_merge(
    islandProps(id, props),
    render.props_attr("data-lumina-hydration-mode", "defer")
  )
}

pub fn renderChunks(node: VNode) -> any {
  render.renderToChunks(node)
}

pub fn renderReadableStream(node: VNode) -> any {
  render.renderToReadableStream(node)
}

pub fn renderApp<P>(renderFn: fn(P) -> VNode, props: P, options: any) -> string {
  render.ssgRenderApp(renderFn, props, options)
}

pub fn writePage(filePath: string, body: any, options: any) -> string {
  render.ssgWritePage(filePath, body, options)
}

pub fn writeApp<P>(filePath: string, renderFn: fn(P) -> VNode, props: P, options: any) -> string {
  render.ssgWriteApp(filePath, renderFn, props, options)
}
