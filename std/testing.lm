import { render } from "@std";

pub fn createDomHarness() -> any {
  render.testingCreateDomHarness()
}

pub fn mountApp<P>(harness: any, renderFn: fn(P) -> VNode, props: P) -> ReactiveRenderRoot {
  render.testingMountApp(harness, renderFn, props)
}

pub fn hydrateApp<P>(harness: any, renderFn: fn(P) -> VNode, props: P) -> ReactiveRenderRoot {
  render.testingHydrateApp(harness, renderFn, props)
}

pub fn container(harness: any) -> any {
  render.testingContainer(harness)
}

pub fn body(harness: any) -> any {
  render.testingBody(harness)
}

pub fn getById(harness: any, id: string) -> any {
  render.testingGetById(harness, id)
}

pub fn getByText(scope: any, value: string) -> any {
  render.testingGetByText(scope, value)
}

pub fn getByRole(scope: any, role: string) -> any {
  render.testingGetByRole(scope, role)
}

pub fn getByRoleName(scope: any, role: string, name: string) -> any {
  render.testingGetByRoleName(scope, role, name)
}

pub fn getByLabel(scope: any, label: string) -> any {
  render.testingGetByLabel(scope, label)
}

pub fn getByPlaceholder(scope: any, placeholder: string) -> any {
  render.testingGetByPlaceholder(scope, placeholder)
}

pub fn queryAllByRole(scope: any, role: string) -> any {
  render.testingQueryAllByRole(scope, role)
}

pub fn text(node: any) -> string {
  render.testingTextContent(node)
}

pub fn click(node: any) -> void {
  render.testingClick(node)
}

pub fn input(node: any, value: string) -> void {
  render.testingInput(node, value)
}

pub fn changeChecked(node: any, checked: bool) -> void {
  render.testingChangeChecked(node, checked)
}

pub fn keydown(node: any, key: string, shiftKey: bool) -> void {
  render.testingKeydown(node, key, shiftKey)
}

pub fn submit(node: any) -> void {
  render.testingSubmit(node)
}

pub async fn flush() -> void {
  await render.testingFlush()
}

pub async fn act(action: fn() -> void) -> void {
  action()
  await flush()
}

pub async fn actAsync(action: fn() -> Promise<any>) -> void {
  let _ = await action()
  await flush()
}

pub async fn waitFor(check: fn() -> any, attempts: int) -> any {
  render.testingWaitFor(check, attempts)
}

pub async fn waitForIdle(attempts: int) -> void {
  let _ = await waitFor(fn() -> any { false }, attempts)
  await flush()
}

pub async fn waitForText(scope: any, value: string, attempts: int) -> any {
  let _ = await waitFor(fn() -> any { getByText(scope, value) }, attempts)
  return getByText(scope, value)
}

pub async fn waitForRoleName(scope: any, role: string, name: string, attempts: int) -> any {
  let _ = await waitFor(fn() -> any { getByRoleName(scope, role, name) }, attempts)
  return getByRoleName(scope, role, name)
}

pub async fn findByText(scope: any, value: string) -> any {
  let _ = await waitFor(fn() -> any { getByText(scope, value) }, 5)
  return getByText(scope, value)
}

pub async fn findByRole(scope: any, role: string) -> any {
  let _ = await waitFor(fn() -> any { getByRole(scope, role) }, 5)
  return getByRole(scope, role)
}

pub async fn findByRoleName(scope: any, role: string, name: string) -> any {
  let _ = await waitFor(fn() -> any { getByRoleName(scope, role, name) }, 5)
  return getByRoleName(scope, role, name)
}

pub async fn findByLabel(scope: any, label: string) -> any {
  let _ = await waitFor(fn() -> any { getByLabel(scope, label) }, 5)
  return getByLabel(scope, label)
}

pub async fn findByPlaceholder(scope: any, placeholder: string) -> any {
  let _ = await waitFor(fn() -> any { getByPlaceholder(scope, placeholder) }, 5)
  return getByPlaceholder(scope, placeholder)
}

pub async fn settle(attempts: int) -> void {
  await waitForIdle(attempts)
}

pub async fn clickAndFlush(node: any) -> void {
  click(node)
  await flush()
}

pub async fn inputAndFlush(node: any, value: string) -> void {
  input(node, value)
  await flush()
}

pub async fn submitAndFlush(node: any) -> void {
  submit(node)
  await flush()
}
