import { render, str } from "@std";

pub struct DevtoolsSnapshot {
  roots: any,
  resources: any,
  signals: any,
  timeline: any
}

pub struct InspectorRecord {
  kind: string,
  label: string,
  detail: any
}

pub struct InspectorPanel {
  kind: string,
  title: string,
  records: any
}

pub fn snapshot() -> any {
  render.devtoolsSnapshot()
}

pub fn snapshotTyped() -> DevtoolsSnapshot {
  render.devtoolsSnapshot()
}

pub fn install() -> any {
  render.installDevtools()
}

pub fn record(eventType: string, label: string, detail: any) -> any {
  render.devtoolsRecordEvent(eventType, label, detail)
}

pub fn resources() -> any {
  snapshotTyped().resources
}

pub fn signals() -> any {
  snapshotTyped().signals
}

pub fn roots() -> any {
  snapshotTyped().roots
}

pub fn recordRoute(label: string, detail: any) -> any {
  record("route", label, detail)
}

pub fn recordResource(label: string, detail: any) -> any {
  record("resource", label, detail)
}

pub fn recordHydration(label: string, detail: any) -> any {
  record("hydration", label, detail)
}

pub fn inspect(kind: string, label: string, detail: any) -> any {
  record(str.concat("inspect:", kind), label, detail)
}

pub fn inspectorRecord(kind: string, label: string, detail: any) -> InspectorRecord {
  InspectorRecord { kind: str.concat("inspect:", kind), label: label, detail: detail }
}

pub fn inspectorPanel(kind: string, title: string, records: any) -> InspectorPanel {
  InspectorPanel { kind: str.concat("inspect:", kind), title: title, records: records }
}

pub fn routeInspector(title: string, records: any) -> InspectorPanel {
  inspectorPanel("route", title, records)
}

pub fn resourceInspector(title: string, records: any) -> InspectorPanel {
  inspectorPanel("resource", title, records)
}

pub fn hydrationInspector(title: string, records: any) -> InspectorPanel {
  inspectorPanel("hydration-mismatch", title, records)
}

pub fn inspectSignal(label: string, detail: any) -> any {
  inspect("signal", label, detail)
}

pub fn inspectResource(label: string, detail: any) -> any {
  inspect("resource", label, detail)
}

pub fn inspectFrame(label: string, detail: any) -> any {
  inspect("frame", label, detail)
}

pub fn inspectRoute(label: string, detail: any) -> any {
  inspect("route", label, detail)
}

pub fn inspectHydrationMismatch(label: string, detail: any) -> any {
  inspect("hydration-mismatch", label, detail)
}

pub fn recordRouteTransition(label: string, detail: any) -> any {
  inspect("route-transition", label, detail)
}

pub fn recordResourceTiming(label: string, detail: any) -> any {
  inspect("resource-timing", label, detail)
}

pub fn recordSignalDependency(label: string, detail: any) -> any {
  inspect("signal-dependency", label, detail)
}

pub fn recordHydrationRecovery(label: string, detail: any) -> any {
  inspect("hydration-recovery", label, detail)
}

pub fn profileStart(label: string, detail: any) -> any {
  record("profile:start", label, detail)
}

pub fn profileEnd(label: string, detail: any) -> any {
  record("profile:end", label, detail)
}

pub fn recordRenderCost(label: string, detail: any) -> any {
  record("render-cost", label, detail)
}

pub fn recordProfilerSpan(label: string, durationMs: int, detail: any) -> any {
  record("profile:span", label, render.props_merge(detail, render.props_attr("durationMs", durationMs)))
}

pub fn timeline() -> any {
  render.devtoolsTimeline()
}

pub fn clearTimeline() -> void {
  render.devtoolsClearTimeline()
}
