import { render } from "@std";

pub fn snapshot() -> any {
  render.devtoolsSnapshot()
}

pub fn install() -> any {
  render.installDevtools()
}

pub fn record(eventType: string, label: string, detail: any) -> any {
  render.devtoolsRecordEvent(eventType, label, detail)
}

pub fn timeline() -> any {
  render.devtoolsTimeline()
}

pub fn clearTimeline() -> void {
  render.devtoolsClearTimeline()
}
