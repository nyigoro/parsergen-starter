import { reactive, render } from "@std";

pub struct FieldState {
  dirty: Signal<bool>,
  touched: Signal<bool>,
  error: Signal<string>
}

pub struct FormAction<T> {
  resource: any,
  submitting: Signal<bool>
}

pub fn bindValue(value: Signal<string>, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_value(reactive.get(value)),
      render.props_on_input(fn(next: string) -> void {
        let _ = reactive.set(value, next)
      })
    )
  )
}

pub fn textInput(value: Signal<string>, props: any) -> any {
  bindValue(value, render.props_merge(props, render.props_type("text")))
}

pub fn textArea(value: Signal<string>, props: any) -> any {
  bindValue(value, props)
}

pub fn bindChecked(value: Signal<bool>, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_checked(reactive.get(value)),
      render.props_on_checked_change(fn(next: bool) -> void {
        let _ = reactive.set(value, next)
      })
    )
  )
}

pub fn checkbox(value: Signal<bool>, props: any) -> any {
  bindChecked(value, render.props_merge(props, render.props_type("checkbox")))
}

pub fn radio(name: string, selected: Signal<string>, optionValue: string, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_type("radio"),
      render.props_merge(
        render.props_name(name),
        render.props_merge(
            render.props_value(optionValue),
          render.props_merge(
            render.props_checked(reactive.get(selected) == optionValue),
            render.props_on_checked_change(fn(next: bool) -> void {
              if (next) {
                let _ = reactive.set(selected, optionValue)
              }
            })
          )
        )
      )
    )
  )
}

pub fn submitProps(handler: fn() -> any, props: any) -> any {
  render.props_merge(props, render.props_on_submit(handler))
}

pub fn createFieldState() -> FieldState {
  FieldState {
    dirty: reactive.createSignal(false),
    touched: reactive.createSignal(false),
    error: reactive.createSignal("")
  }
}

pub fn markDirty(field: FieldState) -> void {
  let _ = reactive.set(field.dirty, true)
}

pub fn markTouched(field: FieldState) -> void {
  let _ = reactive.set(field.touched, true)
}

pub fn setFieldError(field: FieldState, message: string) -> void {
  let _ = reactive.set(field.error, message)
}

pub fn fieldIsValid(field: FieldState) -> bool {
  return reactive.get(field.error) == ""
}

pub fn action<T>(key: any, submit: fn() -> Promise<T>) -> FormAction<T> {
  FormAction<T> {
    resource: render.createResource(key, fn() -> Promise<any> { submit() }, render.props_attr("enabled", false)),
    submitting: reactive.createSignal(false)
  }
}

pub async fn submitAction<T>(formAction: FormAction<T>) -> T {
  let _start = reactive.set(formAction.submitting, true)
  let value = await render.resourceRefresh<T>(formAction.resource)
  let _done = reactive.set(formAction.submitting, false)
  return value
}

pub fn actionStatus<T>(formAction: FormAction<T>) -> string {
  render.resourceStatus(formAction.resource)
}

pub fn actionData<T>(formAction: FormAction<T>) -> any {
  render.resourceData(formAction.resource)
}

pub fn actionError<T>(formAction: FormAction<T>) -> any {
  render.resourceError(formAction.resource)
}

pub fn actionSubmitting<T>(formAction: FormAction<T>) -> Signal<bool> {
  return formAction.submitting
}

pub fn actionSubmitProps<T>(formAction: FormAction<T>, props: any) -> any {
  submitProps(fn() -> any {
    let _ = submitAction(formAction)
  }, props)
}

pub fn required(value: string, message: string) -> string {
  if (value == "") {
    return message
  } else {
    return ""
  }
}

pub fn minLength(value: string, min: int, message: string) -> string {
  if (len(value) < min) {
    return message
  } else {
    return ""
  }
}

pub fn maxLength(value: string, max: int, message: string) -> string {
  if (len(value) > max) {
    return message
  } else {
    return ""
  }
}

pub fn isValid(error: string) -> bool {
  return error == ""
}
