import { reactive, render, str } from "@std";

pub struct FieldState {
  dirty: Signal<bool>,
  touched: Signal<bool>,
  error: Signal<string>
}

pub struct FormAction<T> {
  resource: any,
  submitting: Signal<bool>
}

pub struct ServerValidation {
  field: string,
  message: string
}

pub fn bindValue(value: Signal<string>, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_value(reactive.get(value)),
      render.props_on_input(fn(next: string) -> void {
        let _ = reactive.set(value, next)
      })
    )
  )
}

pub fn textInput(value: Signal<string>, props: any) -> any {
  bindValue(value, render.props_merge(props, render.props_type("text")))
}

pub fn hiddenInput(value: string, props: any) -> any {
  render.props_merge(props, render.props_merge(render.props_type("hidden"), render.props_value(value)))
}

pub fn fileInput(props: any) -> any {
  render.props_merge(props, render.props_type("file"))
}

pub fn fileInputNamed(name: string, props: any) -> any {
  fileInput(render.props_merge(props, render.props_name(name)))
}

pub fn multipartProps(props: any) -> any {
  render.props_merge(props, render.props_attr("enctype", "multipart/form-data"))
}

pub fn formDataSubmitProps(handler: fn() -> any, props: any) -> any {
  submitProps(handler, multipartProps(props))
}

pub fn textArea(value: Signal<string>, props: any) -> any {
  bindValue(value, props)
}

pub fn bindChecked(value: Signal<bool>, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_checked(reactive.get(value)),
      render.props_on_checked_change(fn(next: bool) -> void {
        let _ = reactive.set(value, next)
      })
    )
  )
}

pub fn checkbox(value: Signal<bool>, props: any) -> any {
  bindChecked(value, render.props_merge(props, render.props_type("checkbox")))
}

pub fn radio(name: string, selected: Signal<string>, optionValue: string, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_type("radio"),
      render.props_merge(
        render.props_name(name),
        render.props_merge(
            render.props_value(optionValue),
          render.props_merge(
            render.props_checked(reactive.get(selected) == optionValue),
            render.props_on_checked_change(fn(next: bool) -> void {
              if (next) {
                let _ = reactive.set(selected, optionValue)
              }
            })
          )
        )
      )
    )
  )
}

pub fn submitProps(handler: fn() -> any, props: any) -> any {
  render.props_merge(props, render.props_on_submit(handler))
}

pub fn nestedFieldName(parent: string, child: string) -> string {
  str.concat(str.concat(parent, "."), child)
}

pub fn fieldArrayName(name: string, index: int) -> string {
  str.concat(str.concat(str.concat(name, "["), str.from_int(index)), "]")
}

pub fn fieldArrayItemName(name: string, index: int, child: string) -> string {
  nestedFieldName(fieldArrayName(name, index), child)
}

pub fn schemaAdapter(name: string, props: any) -> any {
  render.props_merge(props, render.props_attr("data-lumina-schema", name))
}

pub fn serverValidation(field: string, message: string) -> ServerValidation {
  ServerValidation { field: field, message: message }
}

pub fn applyServerValidation(field: FieldState, fieldName: string, validation: ServerValidation) -> bool {
  if (fieldName == validation.field) {
    setFieldError(field, validation.message)
    return true
  }
  return false
}

pub fn serverValidationProps(field: string, props: any) -> any {
  render.props_merge(props, render.props_attr("data-lumina-server-field", field))
}

pub fn fieldErrorId(fieldName: string) -> string {
  str.concat(fieldName, "-error")
}

pub fn fieldHelpId(fieldName: string) -> string {
  str.concat(fieldName, "-help")
}

pub fn fieldErrorProps(fieldName: string, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_attr("id", fieldErrorId(fieldName)),
      render.props_attr("role", "alert")
    )
  )
}

pub fn createFieldState() -> FieldState {
  FieldState {
    dirty: reactive.createSignal(false),
    touched: reactive.createSignal(false),
    error: reactive.createSignal("")
  }
}

pub fn markDirty(field: FieldState) -> void {
  let _ = reactive.set(field.dirty, true)
}

pub fn markTouched(field: FieldState) -> void {
  let _ = reactive.set(field.touched, true)
}

pub fn setFieldError(field: FieldState, message: string) -> void {
  let _ = reactive.set(field.error, message)
}

pub fn fieldIsValid(field: FieldState) -> bool {
  return reactive.get(field.error) == ""
}

pub fn fieldControlProps(fieldName: string, field: FieldState, props: any) -> any {
  if (fieldIsValid(field)) {
    return props
  }
  let errorId = fieldErrorId(fieldName)
  render.props_merge(
    props,
    render.props_merge(
      render.props_attr("aria-invalid", true),
      render.props_merge(
        render.props_attr("aria-describedby", errorId),
        render.props_attr("aria-errormessage", errorId)
      )
    )
  )
}

pub fn fieldTouchedError(field: FieldState) -> string {
  if (reactive.get(field.touched) == true) {
    return reactive.get(field.error)
  }
  return ""
}

pub fn validationSummaryProps(props: any) -> any {
  render.props_merge(
    props,
    render.props_attr("role", "alert")
  )
}

pub fn action<T>(key: any, submit: fn() -> Promise<T>) -> FormAction<T> {
  FormAction<T> {
    resource: render.createResource(key, fn() -> Promise<any> { submit() }, render.props_attr("enabled", false)),
    submitting: reactive.createSignal(false)
  }
}

pub fn actionWithOptions<T>(key: any, submit: fn() -> Promise<T>, options: any) -> FormAction<T> {
  FormAction<T> {
    resource: render.createResource(key, fn() -> Promise<any> { submit() }, render.props_merge(options, render.props_attr("enabled", false))),
    submitting: reactive.createSignal(false)
  }
}

pub async fn submitAction<T>(formAction: FormAction<T>) -> T {
  let value = await render.resourceSubmit<T>(formAction.resource, formAction.submitting)
  return value
}

pub async fn submitActionOptimistic<T>(formAction: FormAction<T>, resource: any, optimistic: T) -> T {
  let _mutated = render.resourceMutate(resource, optimistic)
  let value = await submitAction(formAction)
  return value
}

pub async fn submitActionWithRollback<T>(formAction: FormAction<T>, resource: any, optimistic: T, previous: T) -> T {
  let value = await render.resourceSubmitOptimistic<T>(formAction.resource, formAction.submitting, resource, optimistic, previous)
  return value
}

pub async fn submitActionWithCurrentRollback<T>(formAction: FormAction<T>, resource: any, optimistic: T) -> T {
  let previous = render.resourceData(resource)
  let value = await render.resourceSubmitOptimistic<T>(formAction.resource, formAction.submitting, resource, optimistic, previous)
  return value
}

pub fn rollbackResource<T>(resource: any, previous: T) -> T {
  return render.resourceMutate(resource, previous)
}

pub fn actionStatus<T>(formAction: FormAction<T>) -> string {
  render.resourceStatus(formAction.resource)
}

pub fn actionData<T>(formAction: FormAction<T>) -> any {
  render.resourceData(formAction.resource)
}

pub fn actionError<T>(formAction: FormAction<T>) -> any {
  render.resourceError(formAction.resource)
}

pub fn actionSubmitting<T>(formAction: FormAction<T>) -> Signal<bool> {
  return formAction.submitting
}

pub fn actionSubmitProps<T>(formAction: FormAction<T>, props: any) -> any {
  submitProps(fn() -> any {
    let _ = submitAction(formAction)
  }, props)
}

pub fn required(value: string, message: string) -> string {
  if (value == "") {
    return message
  } else {
    return ""
  }
}

pub fn minLength(value: string, min: int, message: string) -> string {
  if (len(value) < min) {
    return message
  } else {
    return ""
  }
}

pub fn maxLength(value: string, max: int, message: string) -> string {
  if (len(value) > max) {
    return message
  } else {
    return ""
  }
}

pub fn isValid(error: string) -> bool {
  return error == ""
}
