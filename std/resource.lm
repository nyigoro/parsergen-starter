import { render } from "@std";

pub struct Resource<T> {
  raw: any
}

pub fn options(props: any) -> any {
  props
}

pub fn cachePolicy(ttlMs: int, staleWhileRevalidate: bool, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_attr("ttlMs", ttlMs),
      render.props_attr("staleWhileRevalidate", staleWhileRevalidate)
    )
  )
}

pub fn backgroundRefresh(ttlMs: int, props: any) -> any {
  cachePolicy(ttlMs, true, props)
}

pub fn requestScope(requestId: string, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_attr("scope", requestId),
      render.props_attr("requestId", requestId)
    )
  )
}

pub fn requestScoped(scope: string, requestId: string, props: any) -> any {
  render.props_merge(
    props,
    render.props_merge(
      render.props_attr("scope", scope),
      render.props_attr("requestId", requestId)
    )
  )
}

pub fn scoped(scope: string, props: any) -> any {
  render.props_merge(props, render.props_attr("scope", scope))
}

pub fn abortOnRefresh(props: any) -> any {
  render.props_merge(props, render.props_attr("abortOnRefresh", true))
}

pub fn tag(tagName: string, props: any) -> any {
  render.props_merge(props, render.props_attr("tags", tagName))
}

pub fn dependency(name: string, props: any) -> any {
  render.props_merge(props, render.props_attr("dependencies", name))
}

pub fn routeDataPolicy(routeId: string, ttlMs: int, props: any) -> any {
  dependency(routeId, scoped(routeId, backgroundRefresh(ttlMs, abortOnRefresh(props))))
}

pub fn routeLifecyclePolicy(routeId: string, ttlMs: int, props: any) -> any {
  tag(routeId, routeDataPolicy(routeId, ttlMs, props))
}

pub fn requestPolicy(requestId: string, ttlMs: int, props: any) -> any {
  requestScope(requestId, backgroundRefresh(ttlMs, abortOnRefresh(props)))
}

pub fn requestRouteDataPolicy(requestId: string, routeId: string, ttlMs: int, props: any) -> any {
  dependency(
    routeId,
    tag(
      routeId,
      render.props_merge(
        routeDataPolicy(routeId, ttlMs, props),
        render.props_attr("requestId", requestId)
      )
    )
  )
}

pub fn routeRequestPolicy(routeId: string, requestId: string, ttlMs: int, props: any) -> any {
  requestRouteDataPolicy(requestId, routeId, ttlMs, props)
}

pub fn requestRouteLifecyclePolicy(requestId: string, routeId: string, ttlMs: int, props: any) -> any {
  requestRouteDataPolicy(requestId, routeId, ttlMs, props)
}

pub fn prefetchOptions(ttlMs: int, props: any) -> any {
  render.props_merge(
    backgroundRefresh(ttlMs, props),
    render.props_attr("enabled", false)
  )
}

pub fn createResource<T>(key: any, loader: fn() -> Promise<T>) -> Resource<T> {
  Resource<T> { raw: render.createResource(key, fn() -> Promise<any> { loader() }, render.props_empty()) }
}

pub fn createResourceWithOptions<T>(key: any, loader: fn() -> Promise<T>, options: any) -> Resource<T> {
  Resource<T> { raw: render.createResource(key, fn() -> Promise<any> { loader() }, options) }
}

pub fn createPrefetchResource<T>(key: any, ttlMs: int, loader: fn() -> Promise<T>) -> Resource<T> {
  createResourceWithOptions(key, loader, prefetchOptions(ttlMs, render.props_empty()))
}

pub fn createPrefetchResourceWithOptions<T>(key: any, ttlMs: int, loader: fn() -> Promise<T>, props: any) -> Resource<T> {
  createResourceWithOptions(key, loader, prefetchOptions(ttlMs, props))
}

pub fn status<T>(resource: Resource<T>) -> string {
  render.resourceStatus(resource.raw)
}

pub fn data<T>(resource: Resource<T>) -> any {
  render.resourceData(resource.raw)
}

pub fn error<T>(resource: Resource<T>) -> any {
  render.resourceError(resource.raw)
}

pub fn read<T>(resource: Resource<T>) -> T {
  render.resourceRead(resource.raw)
}

pub fn refresh<T>(resource: Resource<T>) -> Promise<T> {
  render.resourceRefresh(resource.raw)
}

pub fn invalidate<T>(resource: Resource<T>) -> void {
  render.resourceInvalidate(resource.raw)
}

pub fn invalidateKey(key: any) -> bool {
  render.resourceInvalidateKey(key)
}

pub fn invalidatePrefix(prefix: string) -> int {
  render.resourceInvalidatePrefix(prefix)
}

pub fn invalidateTag(tag: string) -> int {
  render.resourceInvalidateTag(tag)
}

pub fn invalidateDependency(dependency: string) -> int {
  render.resourceInvalidateDependency(dependency)
}

pub fn invalidateScope(scope: string) -> int {
  render.resourceInvalidateScope(scope)
}

pub fn invalidateRequest(requestId: string) -> int {
  render.resourceInvalidateRequest(requestId)
}

pub fn revalidateScope(scope: string) -> int {
  invalidateScope(scope)
}

pub fn clearCache() -> void {
  render.resourceClearCache()
}

pub fn clearScope(scope: string) -> int {
  render.resourceClearScope(scope)
}

pub fn clearRequestScope(requestId: string) -> int {
  render.resourceClearRequest(requestId)
}

pub fn mutate<T>(resource: Resource<T>, value: T) -> T {
  render.resourceMutate(resource.raw, value)
}
