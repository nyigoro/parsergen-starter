import { text, vnode, props_class } from "@std/render";
import { div_node, anchor_node } from "./components.lm";
import { home_view } from "./home.lm";

pub fn app() -> VNode {
  let nav_class = "border-b border-amber-500/20 bg-gray-950/95 px-4 py-3 backdrop-blur sm:px-8";
  let brand = vnode("span", props_class("text-lg font-bold text-amber-100"), [text("Lumina")]);
  let version = vnode("span", props_class("text-sm text-teal-200/50"), [text("v0.5.7")]);
  let brand_row = div_node("flex items-center gap-2", [brand, version]);

  let active_home = vnode(
    "span",
    props_class("inline-flex items-center justify-center rounded-lg bg-amber-400 px-2 py-2 text-xs font-semibold text-gray-950 sm:px-4 sm:text-sm"),
    [text("Home")]
  );
  let docs_link = anchor_node(
    "inline-flex items-center justify-center rounded-lg px-2 py-2 text-xs font-medium text-gray-300 hover:text-amber-100 sm:px-4 sm:text-sm",
    "./docs/",
    "Docs"
  );
  let playground_link = anchor_node(
    "inline-flex items-center justify-center rounded-lg px-2 py-2 text-xs font-medium text-gray-300 hover:text-amber-100 sm:px-4 sm:text-sm",
    "./playground/",
    "Playground"
  );
  let github_link = anchor_node(
    "inline-flex items-center justify-center rounded-lg px-2 py-2 text-xs font-medium text-gray-300 hover:text-amber-100 sm:px-4 sm:text-sm",
    "https://github.com/nyigoro/lumina-lang",
    "GitHub"
  );
  let nav_actions = div_node("grid w-full grid-cols-4 gap-1 sm:flex sm:w-auto sm:flex-wrap sm:justify-end sm:gap-2", [active_home, docs_link, playground_link, github_link]);
  let nav_row = div_node("mx-auto flex max-w-6xl flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between", [brand_row, nav_actions]);
  let nav = vnode("nav", props_class(nav_class), [nav_row]);

  let body = home_view();
  return div_node("min-h-screen bg-gray-950", [nav, body]);
}
