import { div_node, paragraph, anchor_node } from "./components.lm";
import { home_header } from "./home-header.lm";
import { examples_section } from "./home-examples.lm";
import { why_section } from "./home-why.lm";
import { docs_section } from "./home-docs.lm";

pub fn home_view() -> VNode {
  let primary_class = "rounded-lg bg-amber-400 px-6 py-3 font-semibold text-gray-950 hover:bg-amber-300";
  let secondary_class = "rounded-lg border border-teal-700/70 bg-teal-950/80 px-6 py-3 font-medium text-teal-50 hover:bg-teal-900";
  let doc_link_class = "inline-flex items-center rounded-lg border border-amber-500/30 bg-gray-950/70 px-4 py-2 text-sm font-medium text-amber-100 hover:border-amber-300 hover:text-white";

  let hero_copy = paragraph(
    "max-w-2xl text-base leading-8 text-gray-300",
    "Build reactive UIs, browser-native systems, and WASM workloads in one language. Lumina combines HM type inference, traits, pattern matching, and a browser-first runtime."
  );
  let playground_button = anchor_node(
    primary_class,
    "./playground/",
    "Try Playground"
  );
  let docs_button = anchor_node(
    secondary_class,
    "./docs/",
    "Read Docs"
  );
  let why_button = anchor_node(
    doc_link_class,
    "./docs/#/why-lumina",
    "Why Lumina?"
  );
  let github_button = anchor_node(
    doc_link_class,
    "https://github.com/nyigoro/lumina-lang",
    "GitHub"
  );
  let actions = div_node("mt-6 flex flex-wrap gap-4", [playground_button, docs_button, why_button, github_button]);
  let hero_text = div_node("space-y-5", [hero_copy, actions]);
  let hero = div_node("lumina-hero-section", [hero_text]);

  let body = div_node(
    "mx-auto flex max-w-6xl flex-col gap-10 px-6 pb-12 pt-3 lg:px-8",
    [hero, examples_section(), why_section(doc_link_class), docs_section(doc_link_class)]
  );
  return div_node("lumina-home-page min-h-screen text-white", [home_header(), body]);
}
