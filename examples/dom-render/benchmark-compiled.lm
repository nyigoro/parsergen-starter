import { get } from "@std/reactive";
import {
  map_vec,
  forList,
  indexList,
  props_class,
  props_key,
  props_merge,
  text,
  vnode
} from "@std/render";

struct BenchRow {
  id: string,
  label: string
}

pub fn compiledIndexList(rows: Signal<Vec<string>>) -> VNode {
  vnode("ul", props_class("bench-list"), [
    indexList(rows, fn(row: Signal<any>, _index: int) -> VNode {
      vnode("li", props_class("bench-row"), [
        vnode("span", props_class("bench-pill"), [text("row")]),
        vnode("span", props_class("bench-value"), [text(get(row))])
      ])
    })
  ])
}

pub fn compiledReorder(rows: Signal<Vec<BenchRow>>) -> VNode {
  vnode("ul", props_class("bench-list"), [
    map_vec(get(rows), fn(row: BenchRow, _index: int) -> VNode {
      vnode("li", props_merge(props_class("bench-row"), props_key(row.id)), [
        vnode("span", props_class("bench-pill"), [text("row")]),
        vnode("span", props_class("bench-value"), [text(row.label)])
      ])
    })
  ])
}

pub fn compiledForList(rows: Signal<Vec<string>>) -> VNode {
  vnode("ul", props_class("bench-list"), [
    forList(rows, fn(_row: any, index: int) -> int { index }, fn(row: Signal<any>, _index: Signal<int>) -> VNode {
      vnode("li", props_class("bench-row"), [
        vnode("span", props_class("bench-pill"), [text("row")]),
        vnode("span", props_class("bench-value"), [text(get(row))])
      ])
    })
  ])
}
